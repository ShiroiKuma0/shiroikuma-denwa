<resources>

    <style name="AppTheme" parent="AppTheme.Base">
        <!-- Give every popup menu in the app the black/accent surface below, not the platform's grey one -->
        <item name="popupMenuStyle">@style/PopupMenuStyle</item>
        <item name="android:popupMenuStyle">@style/PopupMenuStyle</item>
    </style>

    <!-- Item ("⋮") menus, styled like the top bar's overflow menu: pure black, 2dp yellow border.
         Commons themes its dark popup by setting the framework attr `android:popupMenuStyle` only,
         which an androidx PopupMenu ignores — those menus fell back to Material's grey surface with
         white text. Both attrs are set here, over commons' own popup background drawable (the one
         `TopPopupMenu.Overflow.Dark` uses), so item menus and the top-bar menu stay identical. -->
    <style name="PopupMenuTheme" parent="ThemeOverlay.AppCompat.Dark">
        <item name="popupMenuStyle">@style/PopupMenuStyle</item>
        <item name="android:popupMenuStyle">@style/PopupMenuStyle</item>
    </style>

    <style name="PopupMenuStyle" parent="Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@drawable/top_popup_menu_bg_dark</item>
        <item name="android:popupElevation">@dimen/popup_menu_elevation</item>
    </style>

    <!-- A dial-pad key: a square the size of the dial button, with its digit and letters centred so
         they sit in the middle of the circle painted by DialpadKeyBackground. -->
    <style name="DialpadButtonStyle">
        <item name="android:layout_width">@dimen/dialpad_key_size</item>
        <item name="android:layout_height">@dimen/dialpad_key_size</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="DialpadNumberStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textSize">@dimen/dialpad_text_size</item>
        <item name="android:gravity">center_horizontal</item>
    </style>

    <style name="DialpadLetterStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/dialpad_letters_text_size</item>
        <item name="android:alpha">0.8</item>
        <item name="android:gravity">center_horizontal</item>
    </style>

</resources>
