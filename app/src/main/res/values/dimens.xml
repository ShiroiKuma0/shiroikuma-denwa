<?xml version="1.0" encoding="utf-8"?>
<resources>
    <dimen name="dialpad_button_size">68dp</dimen>
    <!-- The 3x4 grid is packed around the centre column. Key size and gap are tuned together to keep
         the pad 344dp tall: 4 * key + 3 * gap. -->
    <dimen name="dialpad_key_size">80dp</dimen>
    <dimen name="dialpad_key_gap">8dp</dimen>
    <dimen name="dialpad_key_border_width">2dp</dimen>
    <dimen name="dialpad_button_size_small">50dp</dimen>
    <dimen name="incoming_call_arrow_size">50dp</dimen>
    <dimen name="incoming_call_button_size">72dp</dimen>
    <dimen name="silence_call_stroke_width">2dp</dimen>
    <!-- Silence and Block sit as a pair above the answer row; the gap keeps the two 72dp
         buttons clearly apart without crowding the screen edges. -->
    <dimen name="incoming_call_pair_gap">40dp</dimen>
    <!-- An octagon has less room at its flats than a circle, so the glyph sits a touch tighter
         than the silence bell's bigger_margin. -->
    <dimen name="block_call_padding">18dp</dimen>
    <dimen name="block_undo_stroke_width">2dp</dimen>
    <dimen name="block_undo_corner_radius">8dp</dimen>
    <dimen name="call_notification_button_size">40dp</dimen>
    <!-- Decline with a message: the picker and editor rows (DeclineMessageViews), laid out as in
         shiroikuma-jami so the two apps' pickers read alike. -->
    <dimen name="decline_row_padding_horizontal">24dp</dimen>
    <dimen name="decline_row_padding_vertical">12dp</dimen>
    <dimen name="decline_header_padding_top">10dp</dimen>
    <dimen name="decline_header_padding_bottom">2dp</dimen>
    <dimen name="decline_compose_padding_start">20dp</dimen>
    <dimen name="decline_compose_padding">8dp</dimen>
    <dimen name="decline_send_padding">12dp</dimen>
    <dimen name="decline_row_text_size">18sp</dimen>
    <dimen name="decline_body_text_size">16sp</dimen>
    <dimen name="decline_header_text_size">13sp</dimen>
    <dimen name="caller_avatar_max_size">172dp</dimen>
    <dimen name="end_call_button_margin">34dp</dimen>
    <dimen name="dialpad_bottom_padding">114dp</dimen>
    <dimen name="call_control_max_height">240dp</dimen>
    <dimen name="call_control_button_size">72dp</dimen>
    <dimen name="recyclerview_fab_padding">100dp</dimen>

    <dimen name="caller_name_text_size">34sp</dimen>
    <dimen name="call_status_text_size">20sp</dimen>

    <!-- keep these 2 values in dp to avoid scaling -->
    <dimen name="dialpad_text_size">28dp</dimen>
    <dimen name="dialpad_letters_text_size">12dp</dimen>

    <!-- 白い熊 電話 UI page — the kxkb settings house style. Headings are underlined only as wide as
         their words, groups are parted by a 1px full-width hairline, and each cascade level steps in
         18dp: section heading 36 > its rows 72 > subgroup heading 54 > its rows 90. -->
    <dimen name="theme_section_text_size">20sp</dimen>
    <dimen name="theme_subgroup_text_size">17sp</dimen>
    <dimen name="theme_section_rule_height">2.5dp</dimen>
    <dimen name="theme_subgroup_rule_height">1.5dp</dimen>
    <dimen name="theme_section_indent">36dp</dimen>
    <dimen name="theme_subgroup_indent">54dp</dimen>
    <dimen name="theme_row_indent">72dp</dimen>
    <dimen name="theme_row_indent_step">18dp</dimen>
</resources>
