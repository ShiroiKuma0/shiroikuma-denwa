<?xml version="1.0" encoding="utf-8"?>
<!-- An action / navigation row, per the family's settings-page rule (black-yellow-theme skill): an
     outlined pill as wide as its label (never stretched across the line), holding the label — a › at
     its end when the row opens something — and the row's explanation beneath the pill, aligned with
     the label text, in the dim-gold note colour at 13 sp. A row with an explanation carries the thin
     dim-gold left rule, spanning pill and explanation. The pill alone is the touch target.
     The pill's frame (thick for the main action of its section, thin otherwise) is drawn in code. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/theme_action_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingEnd="@dimen/activity_margin"
    tools:ignore="MissingDefaultResource">

    <View
        android:id="@+id/theme_action_rule"
        android:layout_width="@dimen/theme_note_rule_width"
        android:layout_height="match_parent"
        android:layout_marginEnd="@dimen/theme_note_rule_gap"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/theme_action_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/theme_action_pill_padding"
            android:paddingTop="@dimen/theme_action_pill_padding_vertical"
            android:paddingEnd="@dimen/theme_action_pill_padding"
            android:paddingBottom="@dimen/theme_action_pill_padding_vertical">

            <org.fossify.commons.views.MyTextView
                android:id="@+id/theme_action_label"
                style="@style/SettingsTextLabelStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/theme_action_chevron"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/normal_margin"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:text="›"
                android:textSize="22sp"
                tools:ignore="HardcodedText" />

        </LinearLayout>

        <org.fossify.commons.views.MyTextView
            android:id="@+id/theme_action_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/theme_action_pill_padding"
            android:layout_marginTop="@dimen/tiny_margin"
            android:layout_marginEnd="@dimen/theme_action_pill_padding"
            android:textSize="@dimen/theme_note_text_size" />

    </LinearLayout>

</LinearLayout>
