<?xml version="1.0" encoding="utf-8"?><!--
  The keypad, dial line and call button, shared by the Dialpad screen and by the panel that slides up
  over the Recents tab. Wired up by DialpadController, which owns every behaviour on it.

  A vertical stack, so that collapsing the panel is just a matter of hiding the keypad and the call
  button and letting the dial line drop to the bottom on its own.
-->
<org.fossify.phone.views.DialpadDragLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialpad_panel_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <View
        android:id="@+id/dialpad_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@drawable/divider" />

    <LinearLayout
        android:id="@+id/dialpad_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <org.fossify.commons.views.MyEditText
            android:id="@+id/dialpad_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="64dp"
            android:layout_weight="1"
            android:gravity="center"
            android:inputType="phone"
            android:layoutDirection="ltr"
            android:textCursorDrawable="@null"
            android:textSize="@dimen/dialpad_text_size" />

        <ImageView
            android:id="@+id/dialpad_clear_char"
            android:layout_width="@dimen/normal_icon_size"
            android:layout_height="@dimen/normal_icon_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:layoutDirection="ltr"
            android:paddingStart="@dimen/medium_margin"
            android:paddingEnd="@dimen/medium_margin"
            android:src="@drawable/ic_clear_outline_vector" />

        <!-- Stands in for the big call button while the keypad is folded away, so the number on the
             line can still be dialled without bringing the pad back up. -->
        <ImageView
            android:id="@+id/dialpad_line_call"
            android:layout_width="@dimen/normal_icon_size"
            android:layout_height="@dimen/normal_icon_size"
            android:layout_marginStart="@dimen/small_margin"
            android:background="@drawable/circle_button_background_ripple"
            android:contentDescription="@string/call_number"
            android:padding="@dimen/medium_margin"
            android:src="@drawable/ic_phone_vector"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/dialpad_keypad_toggle"
            android:layout_width="@dimen/normal_icon_size"
            android:layout_height="@dimen/normal_icon_size"
            android:layout_marginStart="@dimen/small_margin"
            android:layout_marginEnd="@dimen/activity_margin"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/dialpad_hide_keypad"
            android:paddingStart="@dimen/medium_margin"
            android:paddingEnd="@dimen/medium_margin"
            android:src="@drawable/ic_chevron_down_vector"
            android:visibility="gone" />
    </LinearLayout>

    <include
        android:id="@+id/dialpad_wrapper"
        layout="@layout/dialpad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/medium_margin" />

    <FrameLayout
        android:id="@+id/dialpad_call_button_holder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/dialpad_call_button"
            android:layout_width="@dimen/dialpad_button_size"
            android:layout_height="@dimen/dialpad_button_size"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="@dimen/tiny_margin"
            android:background="@drawable/circle_button_background_ripple"
            android:contentDescription="@string/call_number"
            android:elevation="@dimen/small_margin"
            android:padding="@dimen/normal_margin"
            android:src="@drawable/ic_phone_vector" />
    </FrameLayout>

</org.fossify.phone.views.DialpadDragLayout>
