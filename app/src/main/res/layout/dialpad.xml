<?xml version="1.0" encoding="utf-8"?><!--
    A real dial-pad: every key is a fixed square the size of the dial button, and the 3x4 grid is
    packed around the centre column instead of being stretched across the full width. Each key is a
    vertically centred LinearLayout so the digit (and its letters) sit in the middle of the circle
    that `DialpadKeyBackground` paints into the square.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dialpad_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_alignParentBottom="true"
    android:focusableInTouchMode="true"
    android:layoutDirection="ltr"
    android:paddingTop="@dimen/medium_margin"
    tools:ignore="HardcodedText">

    <!-- Row 1 -->

    <LinearLayout
        android:id="@+id/dialpad_2_holder"
        style="@style/DialpadButtonStyle"
        android:contentDescription="@string/two"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <org.fossify.commons.views.MyTextView
            android:id="@+id/dialpad_2"
            style="@style/DialpadNumberStyle"
            android:text="2" />

        <org.fossify.commons.views.MyTextView
            android:id="@+id/dialpad_2_letters"
            style="@style/DialpadLetterStyle"
            android:text="ABC" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dialpad_1_holder"
        style="@style/DialpadButtonStyle"
        android:layout_marginEnd="@dimen/dialpad_key_gap"
        android:contentDescription="@string/one"
        app:layout_constraintEnd_toStartOf="@+id/dialpad_2_holder"
        app:layout_constraintTop_toTopOf="@+id/dialpad_2_holder">

        <org.fossify.commons.views.MyTextView
            android:id="@+id/dialpad_1"
            style="@style/DialpadNumberStyle"
            android:text="1" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dialpad_3_holder"
        style="@style/DialpadButtonStyle"
        android:layout_marginStart="@dimen/dialpad_key_gap"
        android:contentDescription="@string/three"
        app:layout_constraintStart_toEndOf="@+id/dialpad_2_holder"
        app:layout_constraintTop_toTopOf="@+id/dialpad_2_holder">

        <org.fossify.commons.views.MyTextView
            android:id="@+id/dialpad_3"
            style="@style/DialpadNumberStyle"
            android:text="3" />

        <org.fossify.commons.views.MyTextView
            android:id="@+id/dialpad_3_letters"
            style="@style/DialpadLetterStyle"
            android:text="DEF" />
    </LinearLayout>

    <!-- Row 2 -->

    <LinearLayout
        android:id="@+id/dialpad_5_holder"
        style="@style/DialpadButtonStyle"
        android:layout_marginTop="@dimen/dialpad_key_gap"
        android:contentDescription="@string/five"
        app:layout_constraintEnd_toEndOf="@+id/dialpad_2_holder"
        app:layout_constraintStart_toStartOf="@+id/dialpad_2_holder"
        app:layout_constraintTop_toBottomOf="@+id/dialpad_2_holder">

        <org.fossify.commons.views.MyTextView
            android:id="@+id/dialpad_5"
            style="@style/DialpadNumberStyle"
            android:text="5" />

        <org.fossify.commons.views.MyTextView
            android:id="@+id/dialpad_5_letters"
            style="@style/DialpadLetterStyle"
            android:text="JKL" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dialpad_4_holder"
        style="@style/DialpadButtonStyle"
        android:contentDescription="@string/four"
        app:layout_constraintEnd_toEndOf="@+id/dialpad_1_holder"
        app:layout_constraintStart_toStartOf="@+id/dialpad_1_holder"
        app:layout_constraintTop_toTopOf="@+id/dialpad_5_holder">

        <org.fossify.commons.views.MyTextView
            android:id="@+id/dialpad_4"
            style="@style/DialpadNumberStyle"
            android:text="4" />

        <org.fossify.commons.views.MyTextView
            android:id="@+id/dialpad_4_letters"
            style="@style/DialpadLetterStyle"
            android:text="GHI" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dialpad_6_holder"
        style="@style/DialpadButtonStyle"
        android:contentDescription="@string/six"
        app:layout_constraintEnd_toEndOf="@+id/dialpad_3_holder"
        app:layout_constraintStart_toStartOf="@+id/dialpad_3_holder"
        app:layout_constraintTop_toTopOf="@+id/dialpad_5_holder">

        <org.fossify.commons.views.MyTextView
            android:id="@+id/dialpad_6"
            style="@style/DialpadNumberStyle"
            android:text="6" />

        <org.fossify.commons.views.MyTextView
            android:id="@+id/dialpad_6_letters"
            style="@style/DialpadLetterStyle"
            android:text="MNO" />
    </LinearLayout>

    <!-- Row 3 -->

    <LinearLayout
        android:id="@+id/dialpad_8_holder"
        style="@style/DialpadButtonStyle"
        android:layout_marginTop="@dimen/dialpad_key_gap"
        android:contentDescription="@string/eight"
        app:layout_constraintEnd_toEndOf="@+id/dialpad_5_holder"
        app:layout_constraintStart_toStartOf="@+id/dialpad_5_holder"
        app:layout_constraintTop_toBottomOf="@+id/dialpad_5_holder">

        <org.fossify.commons.views.MyTextView
            android:id="@+id/dialpad_8"
            style="@style/DialpadNumberStyle"
            android:text="8" />

        <org.fossify.commons.views.MyTextView
            android:id="@+id/dialpad_8_letters"
            style="@style/DialpadLetterStyle"
            android:text="TUV" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dialpad_7_holder"
        style="@style/DialpadButtonStyle"
        android:contentDescription="@string/seven"
        app:layout_constraintEnd_toEndOf="@+id/dialpad_4_holder"
        app:layout_constraintStart_toStartOf="@+id/dialpad_4_holder"
        app:layout_constraintTop_toTopOf="@+id/dialpad_8_holder">

        <org.fossify.commons.views.MyTextView
            android:id="@+id/dialpad_7"
            style="@style/DialpadNumberStyle"
            android:text="7" />

        <org.fossify.commons.views.MyTextView
            android:id="@+id/dialpad_7_letters"
            style="@style/DialpadLetterStyle"
            android:text="PQRS" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dialpad_9_holder"
        style="@style/DialpadButtonStyle"
        android:contentDescription="@string/nine"
        app:layout_constraintEnd_toEndOf="@+id/dialpad_6_holder"
        app:layout_constraintStart_toStartOf="@+id/dialpad_6_holder"
        app:layout_constraintTop_toTopOf="@+id/dialpad_8_holder">

        <org.fossify.commons.views.MyTextView
            android:id="@+id/dialpad_9"
            style="@style/DialpadNumberStyle"
            android:text="9" />

        <org.fossify.commons.views.MyTextView
            android:id="@+id/dialpad_9_letters"
            style="@style/DialpadLetterStyle"
            android:text="WXYZ" />
    </LinearLayout>

    <!-- Row 4 -->

    <LinearLayout
        android:id="@+id/dialpad_0_holder"
        style="@style/DialpadButtonStyle"
        android:layout_marginTop="@dimen/dialpad_key_gap"
        android:contentDescription="@string/zero"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/dialpad_8_holder"
        app:layout_constraintStart_toStartOf="@+id/dialpad_8_holder"
        app:layout_constraintTop_toBottomOf="@+id/dialpad_8_holder">

        <org.fossify.commons.views.MyTextView
            android:id="@+id/dialpad_0"
            style="@style/DialpadNumberStyle"
            android:text="0" />

        <org.fossify.commons.views.MyTextView
            android:id="@+id/dialpad_plus_letters"
            style="@style/DialpadLetterStyle"
            android:text="+" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dialpad_plus_holder"
        style="@style/DialpadButtonStyle"
        android:contentDescription="@string/zero"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@+id/dialpad_0_holder"
        app:layout_constraintStart_toStartOf="@+id/dialpad_0_holder"
        app:layout_constraintTop_toTopOf="@+id/dialpad_0_holder">

        <org.fossify.commons.views.MyTextView
            android:id="@+id/dialpad_plus_alt"
            style="@style/DialpadNumberStyle"
            android:text="+" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dialpad_asterisk_holder"
        style="@style/DialpadButtonStyle"
        android:contentDescription="@string/asterisk"
        app:layout_constraintEnd_toEndOf="@+id/dialpad_7_holder"
        app:layout_constraintStart_toStartOf="@+id/dialpad_7_holder"
        app:layout_constraintTop_toTopOf="@+id/dialpad_0_holder">

        <org.fossify.commons.views.MyTextView
            android:id="@+id/dialpad_asterisk"
            style="@style/DialpadNumberStyle"
            android:text="*" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dialpad_hashtag_holder"
        style="@style/DialpadButtonStyle"
        android:contentDescription="@string/hashtag"
        app:layout_constraintEnd_toEndOf="@+id/dialpad_9_holder"
        app:layout_constraintStart_toStartOf="@+id/dialpad_9_holder"
        app:layout_constraintTop_toTopOf="@+id/dialpad_0_holder">

        <org.fossify.commons.views.MyTextView
            android:id="@+id/dialpad_hashtag"
            style="@style/DialpadNumberStyle"
            android:text="#" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
