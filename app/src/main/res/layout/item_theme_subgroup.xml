<?xml version="1.0" encoding="utf-8"?>
<!-- Subgroup header: accent title with a short underline matching the text width (the wrap_content
     column sizes to the single-line text, so the match_parent rule below it is exactly that wide). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/theme_subgroup_holder"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/normal_margin"
    android:paddingEnd="@dimen/activity_margin"
    android:paddingTop="@dimen/small_margin"
    android:paddingBottom="@dimen/tiny_margin"
    tools:ignore="MissingDefaultResource">

    <org.fossify.commons.views.MyTextView
        android:id="@+id/theme_subgroup_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/normal_text_size"
        android:textStyle="bold" />

    <View
        android:id="@+id/theme_subgroup_rule"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginTop="@dimen/tiny_margin" />

</LinearLayout>
