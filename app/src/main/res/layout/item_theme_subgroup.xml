<?xml version="1.0" encoding="utf-8"?>
<!-- Subgroup header (one level under a section), kxkb house style: a medium-bold accent title with an
     underline exactly as wide as the words — the wrap_content column sizes to the single-line text, so
     the match_parent rule below it is that text's width. No full-width hairline: that marks top-level
     groups only. The start indent is applied at runtime, so one layout serves every nesting depth. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/theme_subgroup_holder"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingEnd="@dimen/activity_margin"
    android:paddingTop="@dimen/small_margin"
    android:paddingBottom="@dimen/tiny_margin"
    tools:ignore="MissingDefaultResource">

    <org.fossify.commons.views.MyTextView
        android:id="@+id/theme_subgroup_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/theme_subgroup_text_size"
        android:textStyle="bold" />

    <View
        android:id="@+id/theme_subgroup_rule"
        android:layout_width="match_parent"
        android:layout_height="@dimen/theme_subgroup_rule_height"
        android:layout_marginTop="2dp" />

</LinearLayout>
