<?xml version="1.0" encoding="utf-8"?>
<!-- A call in Recents: the three-line row 電話, 臨電話 and 連絡先 share.

     The picture is a square 90 % as tall as the row, centred on it.

         [picture]  Name                                   ☎  ✉  ⋮
                    +420 735 160 301 · 携帯
                    [1] ↗ 午後五時二分 · （十七秒）          チェコ

     Line 2 is empty when it has nothing to add (no contact behind the number) but keeps its height
     in the list, since the three actions live on it and are as tall as it; in the call-details dialog,
     which has no actions, it goes. The ☎ and ✉ also go for a hidden number. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/item_recents_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:paddingTop="@dimen/small_margin"
    android:paddingBottom="@dimen/small_margin">

    <ImageView
        android:id="@+id/item_recents_image"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/small_margin"
        android:layout_marginEnd="@dimen/small_margin"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintHeight_percent="0.9"
        android:src="@drawable/ic_person_vector"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/item_recents_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/small_margin"
        android:layout_marginEnd="@dimen/normal_margin"
        android:ellipsize="marquee"
        android:focusable="false"
        android:marqueeRepeatLimit="3"
        android:scrollHorizontally="true"
        android:singleLine="true"
        android:textAlignment="viewStart"
        android:textDirection="firstStrongLtr"
        android:textSize="@dimen/bigger_text_size"
        app:layout_constraintBottom_toTopOf="@id/item_recents_number"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/item_recents_image"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="John Doe" />

    <TextView
        android:id="@+id/item_recents_number"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:singleLine="true"
        android:textAlignment="viewStart"
        android:textDirection="firstStrongLtr"
        android:textSize="@dimen/normal_text_size"
        android:layout_marginEnd="@dimen/small_margin"
        app:layout_constraintBottom_toTopOf="@id/item_recents_date_time"
        app:layout_constraintEnd_toStartOf="@+id/item_recents_call"
        app:layout_constraintStart_toStartOf="@id/item_recents_name"
        app:layout_constraintTop_toBottomOf="@id/item_recents_name"
        tools:text="+420 735 160 301 · 携帯" />

    <ImageView
        android:id="@+id/item_recents_sim_image"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/tiny_margin"
        android:padding="@dimen/tiny_margin"
        android:src="@drawable/ic_sim_vector"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/item_recents_date_time"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintStart_toEndOf="@+id/item_recents_image"
        app:layout_constraintTop_toTopOf="@id/item_recents_date_time"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/item_recents_sim_id"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textSize="@dimen/small_text_size"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/item_recents_sim_image"
        app:layout_constraintEnd_toEndOf="@+id/item_recents_sim_image"
        app:layout_constraintStart_toStartOf="@+id/item_recents_sim_image"
        app:layout_constraintTop_toTopOf="@+id/item_recents_sim_image"
        tools:text="1"
        tools:visibility="visible" />

    <ImageView
        android:id="@+id/item_recents_type"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/tiny_margin"
        android:padding="@dimen/tiny_margin"
        android:src="@drawable/ic_call_missed_vector"
        app:layout_constraintBottom_toBottomOf="@+id/item_recents_date_time"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintStart_toEndOf="@+id/item_recents_sim_image"
        app:layout_constraintTop_toTopOf="@+id/item_recents_date_time" />

    <TextView
        android:id="@+id/item_recents_date_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/tiny_margin"
        android:maxLines="1"
        android:textSize="@dimen/normal_text_size"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/item_recents_type"
        app:layout_constraintTop_toBottomOf="@id/item_recents_number"
        tools:text="午後五時二分" />

    <TextView
        android:id="@+id/item_recents_date_time_duration_separator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/small_margin"
        android:gravity="end"
        android:textSize="@dimen/normal_text_size"
        app:layout_constraintBottom_toBottomOf="@id/item_recents_date_time"
        app:layout_constraintStart_toEndOf="@+id/item_recents_date_time"
        app:layout_constraintTop_toTopOf="@id/item_recents_date_time"
        tools:text="·" />

    <TextView
        android:id="@+id/item_recents_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/small_margin"
        android:gravity="end"
        android:maxLines="1"
        android:textSize="@dimen/normal_text_size"
        app:layout_constraintBottom_toBottomOf="@id/item_recents_date_time"
        app:layout_constraintStart_toEndOf="@id/item_recents_date_time_duration_separator"
        app:layout_constraintTop_toTopOf="@id/item_recents_date_time"
        tools:text="（十七秒）" />

    <TextView
        android:id="@+id/item_recents_location"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/normal_margin"
        android:layout_marginEnd="@dimen/activity_margin"
        android:ellipsize="end"
        android:gravity="end"
        android:maxLines="1"
        android:textSize="@dimen/normal_text_size"
        app:layout_constraintBottom_toBottomOf="@id/item_recents_date_time"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/item_recents_duration"
        app:layout_constraintTop_toTopOf="@id/item_recents_date_time"
        tools:text="チェコ" />

    <!-- The three things a row offers at its right end: call this number back on the SIM this row's
         call used, write to it, and the row's own menu. They live on line 2 only, each as tall as
         that line, so the name above keeps the row's whole width on a narrow screen. The ⋮ box is
         half as wide as the others (its glyph is three dots in the middle of a square, cropped to
         them), which is what makes the gaps between the three look equal. -->
    <ImageView
        android:id="@+id/item_recents_call"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginEnd="@dimen/recent_action_gap"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/row_call_back"
        android:src="@drawable/ic_phone_vector"
        app:layout_constraintBottom_toBottomOf="@id/item_recents_number"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toStartOf="@+id/item_recents_message"
        app:layout_constraintTop_toTopOf="@id/item_recents_number" />

    <ImageView
        android:id="@+id/item_recents_message"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginEnd="@dimen/recent_action_gap_menu"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/row_send_message"
        android:src="@drawable/ic_message_outline"
        app:layout_constraintBottom_toBottomOf="@id/item_recents_number"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toStartOf="@+id/overflow_menu_icon"
        app:layout_constraintTop_toTopOf="@id/item_recents_number" />

    <ImageView
        android:id="@+id/overflow_menu_icon"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginEnd="@dimen/normal_margin"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="@id/item_recents_number"
        app:layout_constraintDimensionRatio="1:2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/item_recents_number"
        app:srcCompat="@drawable/ic_three_dots_vector" />

    <!-- What a tap on the SIM badge lands on: the badge is only as tall as line 3's text, so this
         covers it and the arrow beside it, down to the row's bottom edge. Opens the SIM dialog. -->
    <View
        android:id="@+id/item_recents_sim_touch"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/sim_dialog_open"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/item_recents_type"
        app:layout_constraintStart_toStartOf="@+id/item_recents_sim_image"
        app:layout_constraintTop_toTopOf="@+id/item_recents_date_time" />

    <View
        android:id="@+id/overflow_menu_anchor"
        style="@style/OverflowMenuAnchorStyle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
